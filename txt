      /* Estilos para o rodapé */
      footer {
        background-color: #2b2626; /* Cor de fundo cinza escuro */
        color: white; /* Cor do texto branca */
        text-align: center; /* Centraliza o texto */
        padding: 1.5rem; /* Preenchimento interno */
        display: flex; /* Usa o modelo de layout flexbox */
        justify-content: space-around; /* Espaça os itens no rodapé */
        flex-wrap: wrap; /* Permite que os itens quebrem para a próxima linha se necessário */
      }

      /* Estilos para itens do rodapé */
      footer .rodapé {
        margin: 1rem; /* Margem ao redor do rodapé */
      }

      /* Estilos para listas no rodapé */
      footer .rodapé ul {
        list-style: none; /* Remove marcadores padrão das listas */
      }

      /* Estilos para itens da lista no rodapé */
      footer .rodapé ul li {
        margin-bottom: 0.5px; /* Margem abaixo de cada item */
      }

      /* Estilos para links no rodapé */
      footer .rodapé ul li a {
        color: rgb(255, 255, 255); /* Cor do texto do link */
      }

      /* Efeito de hover nos links do rodapé */
      footer .rodapé ul li a:hover {
        color: rgb(255, 255, 255); /* Cor do texto ao passar o mouse (mantém a mesma cor) */
      }

      /* Estilos responsivos */
      @media(max-width: 768px) { /* Para telas menores que 768px */
        nav {
            width: 100%; /* Largura total do menu */
            position: relative; /* Posição relativa para se ajustar ao layout */
        }

        main {
            margin-left: 0; /* Remove a margem à esquerda */
        }
      }

      /* Estilos adicionais para o rodapé em telas menores */
      footer {
        flex-direction: column; /* Organiza os itens em coluna */
        align-items: center; /* Centraliza os itens */
      }

    /* Responsividade para tablets */
    @media (max-width: 1024px) {
        .pesquisa {
            width: 80%; /* Reduz a largura da barra de pesquisa */
            margin: 0 auto; /* Centraliza a barra */
        }
        header {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .logo {
            width: 120px; /* Reduz a logo */
        }
        nav.menu-lateral {
            width: 100%; /* Torna o menu lateral horizontal */
            height: auto; /* Ajusta altura */
            padding: 10px;
        }
        main {
            margin-left: 0; /* Remove o espaçamento lateral */
        }
    }

    /* Responsividade para smartphones */
    @media (max-width: 768px) {
        .pesquisa {
            width: 100%; /* Ocupa a largura total */
        }
        .serch-txt {
            height: 40px; /* Reduz a altura do campo */
            font-size: 0.9rem; /* Ajusta o tamanho do texto */
        }
        .logo {
            width: 100px;
        }
        nav.menu-lateral {
            position: relative;
            width: 100%;
        }
        ul li.item-menu {
            margin-bottom: 15px; /* Reduz o espaço entre itens */
        }
    }

    /* Responsividade para telas muito pequenas (celulares menores) */
    @media (max-width: 480px) {
        header {
            font-size: 1.2rem; /* Reduz o tamanho da fonte */
        }
        .serch-txt {
            width: 100%; /* Campo de texto ocupa largura total */
        }
        .serch-btn {
            font-size: 0.9rem;
        }
        footer {
            flex-direction: column;
            align-items: center;
            font-size: 0.8rem; /* Diminui o tamanho do texto */
        }
    }
