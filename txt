    .carousel{
      display: flex;
      justify-content: flex-start;
      align-items: center;
      overflow: hidden;
      width: 80%; /* Ajuste conforme necessário */
      max-width: 1150px;
      height: 750px;
      position: relative;
      border: solid 0px #ffffff;
      padding-left: 20%;
    }  

    .casousel-item{
      position: absolute;
      top:0;
      bottom:0;
      left:0;
      right: 0;
      padding: 25px 50px;
      opacity:0;
      transition: all 0.5s ease-in-out;
    }

    .arrow{
      border: solid #24e2e5;
      border-width: 0 6px 6px 0;
      display: inline-block;
      padding: 15px;

    }

    .prev{
      top: 50%;
      left:30px;
      position: absolute;
      transform: translateY(-50%) rotate(135deg);
    }

    .next{
      top: 50%;
      right: 30px;
      position: absolute;
      transform: translateY(-50%) rotate(-45deg);
    }

    [id^="item"]{
      display: none;
    }

    .item-1{
      z-index: 2;
      opacity: 1;
      background: url(novo/emi.png);
      background-size: cover;
    }

    .item-2{
      background: url("novo/alice.jpg");
      background-size: cover;
    }
    .item-3{
      background: url("webp/acotar.webp");
      background-size: cover;
    }


    *:target~.item-1{
      opacity: 1;
    }
    #item-2:target~.item-2,
    #item-3:target~.item-3{ 
      z-index: 3;
      opacity: 1;
    }


